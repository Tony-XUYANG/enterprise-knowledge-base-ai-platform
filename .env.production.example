# Copy to .env.production and replace every CHANGE_ME value before deployment.
NODE_ENV=production

POSTGRES_DB=knowledgehub
POSTGRES_USER=knowledgehub
POSTGRES_PASSWORD=CHANGE_ME_use_a_long_random_database_password

DATABASE_URL=postgresql://knowledgehub:CHANGE_ME_use_a_long_random_database_password@db:5432/knowledgehub
JWT_SECRET=CHANGE_ME_generate_at_least_32_random_characters
DATA_ENCRYPTION_KEY=CHANGE_ME_generate_64_hex_characters

TRUST_PROXY=false
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
BCRYPT_ROUNDS=12
PASSWORD_HISTORY_LIMIT=5
PASSWORD_RESET_TOKEN_TTL_MINUTES=30
EMAIL_VERIFICATION_TOKEN_TTL_HOURS=24
MEMBER_INVITATION_TTL_HOURS=72
MFA_ISSUER=KnowledgeHub
MFA_LOGIN_CHALLENGE_TTL_MINUTES=5
MFA_SETUP_CHALLENGE_TTL_MINUTES=10
MFA_MAX_ATTEMPTS=5
LOGIN_FAILURE_LIMIT=5
LOGIN_FAILURE_WINDOW_MINUTES=15
LOGIN_LOCKOUT_MINUTES=15

FASTGPT_API_BASE_URL=https://api.fastgpt.in/api/v1
FASTGPT_TIMEOUT_MS=30000
CORS_ORIGIN=https://knowledge.example.com
WEB_BASE_URL=https://knowledge.example.com

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=true
SMTP_USER=CHANGE_ME_smtp_user
SMTP_PASSWORD=CHANGE_ME_smtp_password
MAIL_FROM=KnowledgeHub <no-reply@example.com>
LOG_LEVEL=info
DB_POOL_MAX=10
DB_POOL_IDLE_TIMEOUT_MS=30000
DB_POOL_CONNECTION_TIMEOUT_MS=5000
